PORT=3000
# Required. Random value of at least 32 characters (e.g. `openssl rand -hex 32`);
# the server refuses to start without it or with the placeholder 'update_your_JWT_secret'.
JWT_SECRET=
BASE_API_URL=api
# Base URL of the storefront: password-reset and merchant-signup links and the
# OAuth redirects are built from it (never from the request's Host header).
CLIENT_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# HTTP hardening
# ---------------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS and the support-chat socket
# (default: CLIENT_URL). Example for the Vite dev server:
# CORS_ORIGINS=http://localhost:8080,http://localhost:8090
CORS_ORIGINS=
# Number of reverse proxies in front of the API (1 behind web/nginx.conf), `true`,
# or an address/subnet list. Leave empty when the API is reached directly. The
# rate limiters count the client address derived from this.
TRUST_PROXY=
# Per-IP request budgets (per 15 min for AUTH/FORMS, per minute for AI); 0 disables.
RATE_LIMIT_AUTH=50
RATE_LIMIT_FORMS=30
RATE_LIMIT_AI=30

# ---------------------------------------------------------------------------
# Data store
# ---------------------------------------------------------------------------
# Local MongoDB (migration source):
MONGO_URI=mongodb://127.0.0.1:27017/mern_ecommerce
# Oracle Database API for MongoDB (migration target) - enable the MongoDB API in
# the Autonomous Database tool configuration first, then use its public URL:
# MONGO_URI=mongodb://<schema>:<password>@<adb-host>:27017/<schema>?loadBalanced=true&retryWrites=false&authMechanism=PLAIN&authSource=$external&tls=true

# ---------------------------------------------------------------------------
# SQL access (migration showcase, validity report, vector search)
# ---------------------------------------------------------------------------
# A bare service name does not resolve in node-oracledb thin mode (NJS-516), so
# use the full descriptor (as below) or the EZConnect form
# tcps://<adb-host>:1522/<service_name>?ssl_server_dn_match=yes
ORACLE_CONNECT_STRING='(description= (retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=<adb-host>))(connect_data=(service_name=<service_name>))(security=(ssl_server_dn_match=yes)))'
# Quote any value that contains '#' - dotenv keeps it, but Node's --env-file
# parser truncates an unquoted value at the '#' (or leave '#' out of passwords).
ORACLE_APP_PASSWORD='<app-schema-password>'
ORACLE_USER=
# only needed for the setup scripts (sql/26ai/01..): ADMIN
ORACLE_PASSWORD=
# Schema names - plain identifiers, no quotes needed.
# ORACLE_APP_USER: schema owning the migrated JSON collections
ORACLE_APP_USER=
# ORACLE_DV_USER: schema owning the duality views
ORACLE_DV_USER=

# ---------------------------------------------------------------------------
# AI: OpenAI-compatible chat + embeddings (replaces the previous Ollama setup)
# ---------------------------------------------------------------------------
# Works with xAI (Grok), OpenAI, OCI Generative AI's OpenAI-compatible endpoint,
# vLLM, or Ollama's /v1 shim.
#
# OCI Generative AI (LLM_PROVIDER=oci): a bare region URL is normalised to its
# OpenAI-compatible path (/openai/v1) automatically.
# LLM_PROVIDER: `oci` | `openai` (default)
LLM_PROVIDER=oci
OCI_GENAI_ENDPOINT=https://inference.generativeai.<region>.oci.oraclecloud.com
# OCI GenAI API key (sk-...), not an OCI config profile
OCI_GENAI_API_KEY=
# LLM_MODEL: e.g. xai.grok-4.3 (OCI), grok-4 (xAI)
LLM_MODEL=xai.grok-4.3

# Direct OpenAI-compatible endpoint (any provider). Overrides the OCI settings above.
# LLM_BASE_URL: e.g. https://api.x.ai/v1
LLM_BASE_URL=
LLM_API_KEY=
# LLM_EMBEDDING_MODEL: e.g. text-embedding-3-small
LLM_EMBEDDING_MODEL=

# In-database embeddings (no API key needed once the ONNX model is loaded).
# VECTOR_EMBEDDING_MODEL: loaded into the schema by scripts/load_onnx_embedding.py (384 dims)
VECTOR_EMBEDDING_MODEL=ALL_MINILM_L12_V2
EMBEDDING_DIM=384
VECTOR_TABLE=PRODUCT_EMBEDDINGS

# Oracle Select AI profile, created by sql/26ai/09_select_ai.sql
SELECT_AI_PROFILE=MERN_LLM

# Path to the JSON report written by scripts/verify_migration.py --report
MIGRATION_REPORT=

# ---------------------------------------------------------------------------
# Optional integrations (left unconfigured in the migration demo). Without
# MAILGUN_* e-mail is skipped (password reset answers 503); without MAILCHIMP_*
# newsletter sign-up answers 503.
# ---------------------------------------------------------------------------
MAILCHIMP_KEY=
MAILCHIMP_LIST_KEY=
MAILGUN_KEY=
MAILGUN_DOMAIN=
MAILGUN_EMAIL_SENDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
